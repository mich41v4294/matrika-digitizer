# Public URL of this app (CORS, WebSockets, deep links).
PANGOLIN_PUBLIC_URL=http://localhost:8080

# Optional API key to protect mutating endpoints (POST/PUT/PATCH/DELETE) and /api/debug/* routes.
# Leave empty for unauthenticated local single-user operation.
# APP_API_KEY=

# MLX Omni local stack (OpenAI-compatible router).
# Canonical model IDs for Docker and local runs — docker-compose passes these through (no model defaults in compose).
# Use http://127.0.0.1:8080/v1 locally, http://host.docker.internal:8080/v1 in Docker, or http://<mac-mini-lan-ip>:8080/v1 on LAN.
AI_BASE_URL=http://127.0.0.1:8080/v1
AI_MODELS_URL=http://127.0.0.1:8080/v1/models
AI_API_KEY=mlx
AI_PROVIDER=local
LOCAL_MAX_CONCURRENT=1
MODEL_OCR=mlx-community/Qwen3-VL-8B-Instruct-4bit
MODEL_LAYOUT=mlx-community/Qwen3-VL-8B-Instruct-4bit
MODEL_DECISION=LiquidAI/d1-Omni-2B-MLX-8bit
MODEL_EXTRACT=LiquidAI/LFM3-Omni-2B-MLX-4bit
MODEL_STT=mlx-community/whisper-large-v3-turbo-asr-fp16

# Optional remote OpenAI-compatible provider ("freellm" stage provider or hybrid mode).
FREELLM_BASE_URL=https://api.openai.com/v1
FREELLM_API_KEY=
FREELLM_MODEL=gpt-4o-mini

# FamilySearch MCP reads this file and hot-reloads FS_ACCESS_TOKEN.
# Defaults to <DATA_DIR>/familysearch.env (./data/familysearch.env locally, /app/data/familysearch.env in Docker).
# FS_ENV_FILE=./data/familysearch.env
# FS_ENVIRONMENT=production
# FS_TIMEOUT=60

# Paths (docker-compose sets /app/data for the container; override for local runs if needed).
# DATA_DIR=./data
# UPLOAD_DIR=./data/uploads
# MATRIKA_DATA_DIR=./data/uploads/matrika
# CENSUS_DATA_DIR=./data/uploads/slovakiana
# CROPS_DIR=./data/crops
# DB_PATH=./data/matrika.db
# SAMPLE_DIR=./samples
# FRONTEND_DIST_DIR=./frontend/dist

# Docker / NFS Share Storage Mounts:
# Use HOST_DATA_DIR to mount the entire SQLite database + crops + uploads directory onto an external disk/NFS share:
# HOST_DATA_DIR=./data
#
# Or mount dedicated NFS share directories for organized Matrika batches and Slovakiana census scans:
# HOST_MATRIKA_DATA_DIR=./data/uploads/matrika
# HOST_CENSUS_DATA_DIR=./data/uploads/slovakiana
